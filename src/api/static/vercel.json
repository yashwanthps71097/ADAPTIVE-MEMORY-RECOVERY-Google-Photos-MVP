{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RAILWAY-BACKEND-URL.up.railway.app/api/:path*"
    },
    {
      "source": "/photos/:path*",
      "destination": "https://YOUR-RAILWAY-BACKEND-URL.up.railway.app/photos/:path*"
    },
    {
      "source": "/thumbnails/:path*",
      "destination": "https://YOUR-RAILWAY-BACKEND-URL.up.railway.app/thumbnails/:path*"
    }
  ]
}
